# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5000/admin

# Security
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change-this-to-a-different-admin-secret

# Database
DB_PATH=./data/jishua.db

# AI
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic

# Payments - Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_PRO=price_your-stripe-price-id
STRIPE_PRICE_ID_ENTERPRISE=price_your-enterprise-price-id

# Email - SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@jishua.ai

# Admin
ADMIN_EMAIL=admin@jishua.ai
ADMIN_PASSWORD_HASH=
# Run: node -e "console.log(require('bcryptjs').hashSync('your-admin-password', 10))"
# Then paste the hash here